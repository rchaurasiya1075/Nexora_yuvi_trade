rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /desk/{doc} {
      allow read, write: if request.auth != null;
    }
    match /traders/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/desk/meta).data.staff);
    }
    match /accounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/desk/meta).data.staff);
      allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/desk/meta).data.staff);
    }
    match /deposits/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/desk/meta).data.staff);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/desk/meta).data.staff;
    }
    match /ledgers/{uid}/entries/{id} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/desk/meta).data.staff);
      allow write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/desk/meta).data.staff;
    }
  }
}
